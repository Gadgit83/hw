<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Setup screen: draws under the camera cut-out and pads its content by the insets. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/hp_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/hp_bg</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <!-- Game: fills the whole screen, including behind the camera cut-out. The engine keeps its controls
         inside the safe area (insets from GameActivity.engineDisplayInfo). -->
    <style name="GameTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
