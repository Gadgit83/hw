# Pinned dependency versions for the native Android build.
# Override HW_ENGINE_REPO / HW_ENGINE_BRANCH / HW_ENGINE_DIR in the environment if needed.
HW_ENGINE_REPO="${HW_ENGINE_REPO:-https://github.com/Gadgit83/hw}"
HW_ENGINE_BRANCH="${HW_ENGINE_BRANCH:-android-master}"
SDL_TAG=release-2.32.10
SDL_IMAGE_TAG=release-2.8.12
SDL_MIXER_TAG=release-2.8.2
SDL_TTF_TAG=release-2.24.0
SDL_NET_TAG=release-2.2.0
NDK_VERSION=27.2.12479018
CMAKE_VERSION=3.22.1
COMPILE_SDK=34
