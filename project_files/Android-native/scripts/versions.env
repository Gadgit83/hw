# Pinned dependency versions for the native Android build.
# The engine itself is not fetched: it is the checkout this directory is part of.
SDL_TAG=release-2.32.10
SDL_IMAGE_TAG=release-2.8.12
SDL_MIXER_TAG=release-2.8.2
SDL_TTF_TAG=release-2.24.0
SDL_NET_TAG=release-2.2.0
NDK_VERSION=27.2.12479018
CMAKE_VERSION=3.22.1
COMPILE_SDK=34
ROBOLECTRIC_VERSION=4.14.1
# android-all-instrumented jars Robolectric 4.14.1 uses for Android 14 (SDK 34) and 15 (SDK 35): <android>-robolectric-<build>-i7
ROBOLECTRIC_JARS="14-robolectric-10818077-i7 15-robolectric-12650502-i7"
